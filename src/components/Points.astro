---
import { toRunes } from '../runes';
import type { Lang } from '../i18n/languages';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const text = t(Astro.props.lang);
---

<section class="section" id="kan-norsk" aria-labelledby="points-heading">
  <div class="wrap">
    <h2 class="visually-hidden" id="points-heading">{text.pointsHeading}</h2>
    <ul class="points">
      {
        text.points.map((point) => (
          <li>
            <span class="runes" aria-hidden="true">{toRunes(point.heading)}</span>
            <h3>{point.heading}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .points {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    font: 650 clamp(1.5rem, 1.25rem + 1vw, 1.9rem)/1.1 var(--display);
    letter-spacing: -0.01em;
  }

  p {
    margin-top: 0.7rem;
    color: var(--ash);
  }

  @media (min-width: 860px) {
    .points {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
</style>
