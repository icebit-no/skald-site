---
import { languageNames, languages, pageUrl, type Lang } from '../i18n/languages';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);
---

<footer class="site-footer">
  <div class="wrap">
    <p class="brand">
      <img src="/icon-64.png" width="40" height="40" alt="" />
      <span>{text.footerFree}</span>
    </p>
    <ul class="links">
      <li><a href="https://github.com/icebit-no/skald">{text.footerSkaldSource}</a></li>
      <li><a href="https://github.com/icebit-no/skald-site">{text.footerSiteSource}</a></li>
      <li><a href="https://icebit.app">icebit.app</a></li>
      {
        languages
          .filter((l) => l !== lang)
          .map((l) => (
            <li>
              <a href={pageUrl(l, '/')} lang={l} hreflang={l} data-language={l}>
                {languageNames[l]}
              </a>
            </li>
          ))
      }
    </ul>
    <p class="credits">{text.footerModels} {text.footerFonts} {text.footerNoTracking}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 3rem calc(3rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--seam);
    background: var(--hearth);
    font-size: 1rem;
    color: var(--ash);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--bone);
  }

  .brand img {
    flex: none;
    border-radius: 9px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-block;
    padding-block: 0.3rem;
  }

  .credits {
    max-width: 48rem;
    margin-top: 1.25rem;
    font-size: 0.92rem;
  }
</style>
